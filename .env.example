# HOTFLOW environment template — copy to .env and fill locally.
# Never commit real secrets. Never put keys in logs, prompts, or reports.

# --- Trading mode (paper is the only safe default) ---
HOTFLOW_TRADING_MODE=paper
# LIVE requires ALL of: config trading.mode=live, live acceptance flags,
# and this explicit env gate. See docs/architecture.md.
HOTFLOW_ACCEPT_LIVE=0

# --- Kimi K3 (cold-path research only; never on decide/transmit) ---
# Official base: https://api.moonshot.ai/v1  model: kimi-k3
# Docs: https://platform.kimi.ai/docs/guide/kimi-k3-quickstart.md
MOONSHOT_API_KEY=
# Alias accepted by hotflow.ai_research.kimi_client:
KIMI_API_KEY=

# --- Polymarket public endpoints (override only if official docs change) ---
HOTFLOW_GAMMA_BASE=https://gamma-api.polymarket.com
HOTFLOW_CLOB_BASE=https://clob.polymarket.com

# --- LIVE credentials (unused in paper; required only behind live gates) ---
# Official L1/L2 auth: https://docs.polymarket.com/getting-started/api
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Optional Chainlink Data Streams (direct TWAP; prefer Polymarket RTDS)
# Docs: https://docs.polymarket.com/market-data/chainlink-twap
CHAINLINK_CLIENT_ID=
CHAINLINK_CLIENT_SECRET=
